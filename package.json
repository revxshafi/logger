{
  "name": "@revxshafi/logger",
  "version": "1.0.0",
  "description": "Flexible, colorful, and easy-to-use logging for Node.js — fixed log levels, context tags, scoped loggers, and pluggable transports.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:package": "publint && attw --pack .",
    "verify": "tsx verify.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npx publint && npx attw --pack ."
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "chalk",
    "colorful",
    "console",
    "timestamp",
    "context",
    "scoped",
    "transport",
    "nodejs",
    "debug"
  ],
  "author": "revxshafi <reversalxp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revxshafi/logger.git"
  },
  "bugs": {
    "url": "https://github.com/revxshafi/logger/issues"
  },
  "homepage": "https://github.com/revxshafi/logger#readme",
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "publint": "^0.3.21",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
